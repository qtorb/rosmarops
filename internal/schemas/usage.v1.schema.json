{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosmarops.com/schemas/usage.v1.schema.json",
  "title": "usage.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "install_id", "day", "version", "os", "arch", "channel", "agents", "score", "class", "status", "findings", "space_connected", "plugin_installed"],
  "properties": {
    "schema": { "const": "usage.v1" },
    "install_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z.+-]{1,40}$" },
    "os": { "enum": ["windows", "darwin", "linux"] },
    "arch": { "enum": ["amd64", "arm64"] },
    "channel": { "enum": ["store", "homebrew", "other", "internal"] },
    "agents": { "type": "array", "maxItems": 40, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" } },
    "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "class": { "enum": ["A", "B", "C", "D", "E", null] },
    "status": { "enum": ["green", "yellow", "red"] },
    "findings": { "type": "object", "maxProperties": 100, "propertyNames": { "pattern": "^[a-z0-9_]{1,64}$" }, "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 100000 } },
    "space_connected": { "type": "boolean" },
    "plugin_installed": { "type": "boolean" }
  }
}
