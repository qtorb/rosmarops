{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rosmarops.com/schemas/factory-scores.v1.schema.json",
  "title": "factory-scores.v1",
  "description": "BV-249 §6 (CTO-58 §5, signed): the factory scores of the reference computer R2, as TestR2FactoryScores writes them for the release. Ids, enums, codes, numbers, versions and dates only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "rosmarops_version",
    "commit",
    "generated_at",
    "reference_computer",
    "index_version",
    "rules_version",
    "knowledge_version",
    "agents"
  ],
  "properties": {
    "format": {
      "const": "rosmarops.factory-scores/1"
    },
    "rosmarops_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "commit": {
      "type": "string",
      "maxLength": 64
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reference_computer": {
      "const": "R2"
    },
    "index_version": {
      "type": "integer",
      "minimum": 1
    },
    "rules_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "knowledge_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "score",
          "band",
          "findings",
          "assumptions"
        ],
        "properties": {
          "product": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 40
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "band": {
            "enum": [
              "exposed",
              "open_gaps",
              "contained"
            ]
          },
          "findings": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "weight"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "maxLength": 64
                },
                "weight": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "assumptions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$",
              "maxLength": 64
            }
          }
        }
      }
    }
  }
}
