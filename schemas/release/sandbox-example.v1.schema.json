{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rosmarops.com/schemas/sandbox-example.v1.schema.json",
  "title": "sandbox-example.v1",
  "description": "BV-249 §6 (CTO-58 §4, signed): the sixteen switch combinations of the sandbox example for the web, on the reference computer R2. Ids, enums, codes, numbers, versions and dates only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "rosmarops_version",
    "commit",
    "generated_at",
    "host_os",
    "index_version",
    "rules_version",
    "knowledge_version",
    "reference_computer",
    "agent",
    "combinations"
  ],
  "properties": {
    "format": {
      "const": "rosmarops.sandbox-example/1"
    },
    "host_os": {
      "const": "linux"
    },
    "agent": {
      "const": "demo-agent"
    },
    "rosmarops_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "commit": {
      "type": "string",
      "maxLength": 64
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reference_computer": {
      "const": "R2"
    },
    "index_version": {
      "type": "integer",
      "minimum": 1
    },
    "rules_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "knowledge_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "combinations": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "switches",
          "valid",
          "reason",
          "score",
          "band",
          "class",
          "class_status",
          "kinds",
          "findings"
        ],
        "properties": {
          "switches": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sandbox",
              "read_only",
              "asks_first",
              "network_cut"
            ],
            "properties": {
              "sandbox": {
                "type": "boolean"
              },
              "read_only": {
                "type": "boolean"
              },
              "asks_first": {
                "type": "boolean"
              },
              "network_cut": {
                "type": "boolean"
              }
            }
          },
          "valid": {
            "type": "boolean"
          },
          "reason": {
            "enum": [
              "network_cut_needs_sandbox",
              null
            ]
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "band": {
            "enum": [
              "exposed",
              "open_gaps",
              "contained",
              null
            ]
          },
          "class": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              null
            ]
          },
          "class_status": {
            "enum": [
              "provisional",
              "final"
            ]
          },
          "kinds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "money",
              "sends_out",
              "keys",
              "runs_commands",
              "changes_files"
            ],
            "properties": {
              "money": {
                "type": "string",
                "pattern": "^[a-z_]+$",
                "maxLength": 32
              },
              "sends_out": {
                "type": "string",
                "pattern": "^[a-z_]+$",
                "maxLength": 32
              },
              "keys": {
                "type": "string",
                "pattern": "^[a-z_]+$",
                "maxLength": 32
              },
              "runs_commands": {
                "type": "string",
                "pattern": "^[a-z_]+$",
                "maxLength": 32
              },
              "changes_files": {
                "type": "string",
                "pattern": "^[a-z_]+$",
                "maxLength": 32
              }
            }
          },
          "findings": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "weight"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "maxLength": 64
                },
                "weight": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
