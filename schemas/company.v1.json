{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rosmarops.com/schemas/company.v1.json",
  "title": "RosmarOps — Company configuration",
  "description": "Read-only for the person; written only by an administrator. Never written by RosmarOps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "first_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_roots"],
      "properties": {
        "repo_roots": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^~/[^\u0000]{1,200}$" }
        }
      }
    }
  }
}
