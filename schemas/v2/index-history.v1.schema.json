{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rosmarops.com/schemas/index-history.v1.schema.json",
  "title": "RosmarOps — Agent Posture Score history v1",
  "description": "index-history.json in the reports directory: one entry per run, at most 104. Never paths, repository names, services, fingerprints or host_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entry"
      },
      "maxItems": 104
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "index_version",
        "rules_version",
        "knowledge_version",
        "agents",
        "scope"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "index_version": {
          "type": "integer",
          "minimum": 1
        },
        "rules_version": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_version": {
          "type": "string",
          "minLength": 1
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "value",
              "red",
              "yellow"
            ],
            "properties": {
              "agent": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                ]
              },
              "unavailable": {
                "enum": [
                  "coverage"
                ]
              },
              "band": {
                "enum": [
                  "exposed",
                  "open_gaps",
                  "contained"
                ]
              },
              "red": {
                "type": "integer",
                "minimum": 0
              },
              "yellow": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agents",
            "repos"
          ],
          "properties": {
            "agents": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "repos": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
