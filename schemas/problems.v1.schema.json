{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rosmarops.com/schemas/problems.v1.schema.json",
  "title": "rosmarops-problems v1",
  "description": "The problem report the program sends only with the person's permission (BV-210, telemetría pasiva, §11). Error codes, the review part, the agent involved if any, the program version, the system and the day; an optional comment and email. Never files, paths, user or computer names, keys or config values. Identical in qtorb/rosmarops and qtorb/rosmarops-app.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "lang",
    "rosmarops_version",
    "os",
    "os_version",
    "arch",
    "problems",
    "comment",
    "email"
  ],
  "properties": {
    "format": {
      "const": "problems.v1"
    },
    "lang": {
      "enum": ["en", "es"]
    },
    "rosmarops_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9A-Za-z.+-]+$"
    },
    "os": {
      "enum": ["windows", "darwin", "linux"]
    },
    "os_version": {
      "type": "string",
      "minLength": 0,
      "maxLength": 40,
      "pattern": "^[0-9A-Za-z._ -]*$"
    },
    "arch": {
      "enum": ["amd64", "arm64"]
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "step", "day", "count"],
        "properties": {
          "code": {
            "enum": [
              "run_unfinished",
              "step_failed",
              "time_ran_out",
              "output_invalid",
              "space_rejected",
              "config_unreadable",
              "report_not_opened"
            ]
          },
          "step": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          },
          "agent": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$"
          },
          "http_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    },
    "comment": {
      "type": ["null", "string"],
      "minLength": 1,
      "maxLength": 1000
    },
    "email": {
      "type": ["null", "string"],
      "minLength": 3,
      "maxLength": 254,
      "pattern": "@"
    }
  }
}
